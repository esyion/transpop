{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TransPop",
  "version": "0.2.9",
  "identifier": "com.krmeow.transpop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TransPop",
        "width": 720,
        "height": 420,
        "minWidth": 520,
        "maxWidth": 900,
        "minHeight": 200,
        "maxHeight": 600,
        "center": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY0Q0Q0ODU4NjAzMEUzQUMKUldTczR6QmdXRWpOWlB2N05oSENaNFdhZDcwZGllRDhweXpTY0hhU29yWEZBdXJ5SjQwNHpldmMK",
      "endpoints": [
        "https://github.com/esyion/transpop/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
